{
  "citekey": "cho2026nickel",
  "apa7": "Cho, S., Lee, Y., & Lee, I. (2026). Comparative assessment of ammonia decomposition processes based on nickel and ruthenium catalysts: A techno-economic perspective. Energy Conversion and Management, 348, 120796. https://doi.org/10.1016/j.enconman.2025.120796",
  "doi": "10.1016/j.enconman.2025.120796",
  "url": "https://doi.org/10.1016/j.enconman.2025.120796",
  "doi_verified": true,
  "year": 2026,
  "type": "article",
  "page_convention": "PDF page numbers (= article pages 1-19). Supplementary Materials (S1 kinetics, S2 cost equations, S3-S6) not available.",
  "simulator": "Aspen Plus V14 (Python Bayesian optimisation wrapper)",
  "property_method": "Peng-Robinson EOS",
  "equations": [
    {"id": "cho2026nickel_eq1", "name": "Ammonia decomposition", "expression": "2 NH3 <-> N2 + 3 H2, dHr = 45.6 kJ/mol NH3", "variables": {"dHr": "reaction enthalpy, kJ per mol NH3"}, "page": 2, "applies_to": "reaction thermochemistry"},
    {"id": "cho2026nickel_eq2", "name": "Specific thermal energy demand", "expression": "q_th [MJ/kg-H2] = LHV_NH3 * m_NH3_fuel / m_H2", "variables": {"LHV_NH3": "lower heating value of NH3, MJ/kg", "m_NH3_fuel": "supplementary NH3 fuel mass flow, kg/s", "m_H2": "H2 product mass flow, kg/s"}, "page": 6, "applies_to": "energy KPI"},
    {"id": "cho2026nickel_eq3", "name": "Specific power demand", "expression": "w [MJ/kg-H2] = W_net / m_H2 * 1/1000", "variables": {"W_net": "net power consumption, kW", "m_H2": "H2 product mass flow, kg/s"}, "page": 6, "applies_to": "energy KPI"},
    {"id": "cho2026nickel_eq4", "name": "Net power", "expression": "W_net = sum_i W_Comp,i + W_Pump - W_Exp", "variables": {"W_Comp,i": "compressor i power, kW", "W_Pump": "pump power, kW", "W_Exp": "expander power generated, kW"}, "page": 6, "applies_to": "energy KPI"},
    {"id": "cho2026nickel_eq5", "name": "Energy (thermal) efficiency", "expression": "eta_th = LHV_H2*m_H2 / (LHV_NH3*(m_NH3_feed + m_NH3_fuel) + W_net/1000) * 100%", "variables": {"LHV_H2": "LHV of H2, MJ/kg (120 MJ/kg quoted p.1)", "LHV_NH3": "LHV of NH3, MJ/kg (18.6 MJ/kg quoted p.2)", "m_NH3_feed": "NH3 feedstock, kg/s", "m_NH3_fuel": "NH3 fuel, kg/s", "W_net": "kW"}, "page": 6, "applies_to": "overall process efficiency"},
    {"id": "cho2026nickel_eq6_8", "name": "Stream exergy", "expression": "Ex = Ex_ph + Ex_ch; Ex_ph = m*((H-H0) - T0*(S-S0)); Ex_ch = (sum_i x_i*STD_i + R*T0*sum_i x_i*ln x_i) * n", "variables": {"m": "mass flow, kg/s", "n": "molar flow, kmol/s", "H,S": "specific enthalpy/entropy", "T0": "298.15 K (25 degC), P0 1.01325 bar", "STD_i": "standard chemical exergy, kJ/kmol", "x_i": "mole fraction", "R": "8.314 J/(mol K)"}, "page": 6, "applies_to": "exergy analysis"},
    {"id": "cho2026nickel_eq9_14", "name": "Exergy balance and efficiency", "expression": "Ex_in = Ex_NH3feed + Ex_NH3fuel + Ex_air + Ex_CWin + Ex_power; Ex_out = Ex_H2 + Ex_exhaust + Ex_CWout; Ex_destr = Ex_in - Ex_out; Ex_loss = Ex_exhaust + Ex_CWout; Ex_unused = Ex_destr + Ex_loss; eta_ex = (1 - Ex_unused/Ex_in)*100% = Ex_H2/Ex_in*100%", "variables": {"Ex": "exergy flow rate, kW"}, "page": 7, "applies_to": "exergy analysis"},
    {"id": "cho2026nickel_eq15", "name": "Levelized cost of hydrogen", "expression": "LCOH = (C_AC + C_AO + C_NOx) / (m_H2 * 3600 * OH)", "variables": {"C_AC": "annualized CAPEX, USD/yr", "C_AO": "annual OPEX, USD/yr", "C_NOx": "annual NOx after-treatment cost, USD/yr", "m_H2": "kg/s", "OH": "operating hours, h/yr (8000)"}, "page": 7, "applies_to": "economics"},
    {"id": "cho2026nickel_eq16_19", "name": "CAPEX annualisation", "expression": "C_AC = C_C * CRF; CRF = d*(1+d)^PL / ((1+d)^PL - 1); C_C = ISBL + OSBL + Engineering + Contingency; ISBL = sum_i IEC_i", "variables": {"d": "discount rate (0.085)", "PL": "plant life, yr (25)", "IEC_i": "installed equipment cost, USD (correlations in SI S2.1, unavailable)", "OSBL": "0.12*ISBL", "Engineering": "0.10*(ISBL+OSBL)", "Contingency": "0.18*(ISBL+OSBL)"}, "page": 7, "applies_to": "economics"},
    {"id": "cho2026nickel_eq20_21", "name": "OPEX", "expression": "C_AO = OPEX_fixed + OPEX_variable; OPEX_variable = C_NH3 + C_Elec + C_CW + C_Ads,TSA + C_Ads,PSA + C_Cat", "variables": {"C_NH3": "NH3 purchase (feed+fuel), USD/yr", "C_Elec": "electricity, USD/yr", "C_CW": "cooling water, USD/yr", "C_Ads": "adsorbent replacement, USD/yr", "C_Cat": "catalyst replacement, USD/yr"}, "page": 7, "applies_to": "economics"},
    {"id": "cho2026nickel_eq22", "name": "NOx after-treatment cost", "expression": "C_NOx = c_NOx * m_NOx * 3600 * OH", "variables": {"c_NOx": "levelized SCR cost, 4 USD/kg NOx", "m_NOx": "NOx emission, kg/s"}, "page": 7, "applies_to": "economics/emissions"},
    {"id": "cho2026nickel_eq23", "name": "Reconversion cost", "expression": "REC = LCOH - C_Feed / (m_H2 * 3600 * OH)", "variables": {"C_Feed": "annual NH3 feedstock cost, USD/yr"}, "page": 7, "applies_to": "economics"},
    {"id": "cho2026nickel_eq25_27", "name": "Boiler combustion and excess air", "expression": "4 NH3 + 3 O2 -> 2 N2 + 6 H2O; 2 H2 + O2 -> 2 H2O; excess_air% = (n_air_feed - n_air_stoi)/n_air_stoi * 100", "variables": {"n_air": "air molar flow, kmol/s"}, "page": 8, "applies_to": "tail-gas boiler"}
  ],
