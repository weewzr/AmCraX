  "doi_verified": true,
  "year": 2024,
  "type": "article",
  "equations": [
    {"id": "Eq1", "name": "Richardson/Sieverts H2 flux", "expression": "J_H2 = (Pe/delta) * (p_H2,ret^n - p_H2,perm^n) [* CP factor]", "variables": {"J_H2": "H2 flux, mol/(s m2)", "Pe": "permeability, mol m-1 s-1 Pa-0.5", "delta": "membrane thickness, m", "p_H2": "H2 partial pressure, Pa", "n": "pressure exponent, 0.5 (Sieverts)"}, "page": 6, "applies_to": "Pd-Ag membrane reactor"},
    {"id": "Eq2", "name": "Arrhenius permeability", "expression": "Pe = Pe0,H2 * exp(-Ea/(R*T))", "variables": {"Pe0,H2": "pre-exponential permeability, mol m-1 s-1 Pa-0.5", "Ea": "activation energy, kJ/mol", "R": "J/(K mol)", "T": "K"}, "page": 7, "applies_to": "Pd-Ag membrane"},
    {"id": "Eq4", "name": "Temkin-Pyzhev-like power law (forward only)", "expression": "R_NH3 = k0 * exp(-E0/(R*T)) * (p_NH3^2/p_H2^3)^beta", "variables": {"k0": "pre-exponential factor (nomenclature: mol m-2 s-1 bar0.5, ambiguous)", "E0": "activation energy, kJ/mol", "p_i": "partial pressure, bar", "beta": "reaction order"}, "page": 7, "applies_to": "Ru catalysts (fitted values only in Suppl. S4)"},
    {"id": "Eq5", "name": "Total plant cost", "expression": "TPC = (sum_i C_i) * (1 + %TIC) * (1 + %IC) * (1 + %C&OC)", "variables": {"C_i": "equipment cost, EUR", "TIC": "installation", "IC": "indirect", "C&OC": "owner's and contingencies"}, "page": 7, "applies_to": "TEA"},
    {"id": "Eq6", "name": "Scaling law", "expression": "C_i = C_i,0 * (S_i/S_i,0)^f", "variables": {"S": "scaling parameter", "f": "scale factor"}, "page": 7, "applies_to": "power island equipment"},
    {"id": "Eq7", "name": "Capital charge factor", "expression": "CCF = i(1+i)^n / ((1+i)^n - 1)", "variables": {"i": "discount rate", "n": "lifetime, yr"}, "page": 7, "applies_to": "TEA"},
    {"id": "Eq8", "name": "LCOH", "expression": "LCOH = (TPC*CCF + C_OM,fix + C_OM,var*heq) / (production capacity * heq)", "variables": {"heq": "equivalent operating hours, h/yr", "production capacity": "kg/h basis"}, "page": 8, "applies_to": "H2 island (heading prints EUR/Nm3; results in EUR/kg)"},
    {"id": "Eq10", "name": "NH3 conversion", "expression": "X_NH3 = (F_NH3,in - F_NH3,out)/F_NH3,in", "variables": {"F": "retentate-side NH3 molar flow"}, "page": 10, "applies_to": "reactor"},
    {"id": "Eq11", "name": "H2 recovery factor", "expression": "HRF = F_H2,perm,out / (1.5 * F_NH3,in) * 100", "variables": {}, "page": 10, "applies_to": "membrane reactor"},
    {"id": "Eq12", "name": "Thermal efficiency", "expression": "eta_th = (F_H2*LHV_H2 - W_aux) / (F_NH3*LHV_NH3)", "variables": {"LHV_H2": "120 MJ/kg", "LHV_NH3": "18 MJ/kg", "W_aux": "auxiliary electric consumption"}, "page": 10, "applies_to": "fuel processor"}
  ],
