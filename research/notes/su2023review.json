    {"id": "eq2", "name": "empirical concentration power law (cited ref 170, Sun et al. 2022)", "expression": "r_NH3 = k * c(NH3)^alpha * c(H2)^beta * c(N2)^gamma", "variables": {"r_NH3": "reaction rate (unit not given)", "c": "gas concentration (unit not given)", "alpha": "NH3 order, > 0", "beta": "H2 order, < 0", "gamma": "N2 order, < 0", "k": "rate constant"}, "page": 16, "applies_to": "general"},
    {"id": "eq3", "name": "Arrhenius", "expression": "k = A * exp(-Ea/(R*T))", "variables": {"A": "pre-exponential factor", "Ea": "activation energy", "R": "8.314 J mol^-1 K^-1", "T": "temperature [K]"}, "page": 16, "applies_to": "general"},
    {"id": "eq4", "name": "Tamaru Langmuir-type rate (cited ref 176, Tamaru 1988)", "expression": "r_NH3 = k_R*K*P_NH3/(1 + K*P_NH3); k_R = 1.57e28*exp(-49600/(R*T)); K = 6.7e-9*exp(39600/(R*T))", "variables": {"k_R": "[molecules cm^-2 s^-1]", "K": "NH3 adsorption constant [Torr^-1]", "P_NH3": "NH3 pressure [Torr, implied by K unit]", "49600, 39600": "energy values; unit NOT stated (likely cal/mol - unverified)"}, "page": 16, "applies_to": "metal surfaces (specific metal not stated in review)"},
    {"id": "eq5", "name": "pressure power law", "expression": "r_NH3 = k' * P_NH3^alpha * P_H2^beta", "variables": {"P_NH3": "NH3 partial pressure", "P_H2": "H2 partial pressure", "alpha": "NH3 order", "beta": "H2 order"}, "page": 16, "applies_to": "general"},
    {"id": "eq6", "name": "'Temkin-Pyzhev' as printed (cited ref 35, Egawa et al. 1984)", "expression": "r_NH3 = k0 * exp(-E_app/(R*T)) * P_NH3^alpha * P_H2^beta", "variables": {"k0": "pre-exponential factor", "E_app": "apparent activation energy"}, "page": 16, "applies_to": "general; NOTE printed form is a power law, not the classical (p_NH3^2/p_H2^3)^beta Temkin-Pyzhev form"}
