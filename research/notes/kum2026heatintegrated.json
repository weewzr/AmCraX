{
  "citekey": "kum2026heatintegrated",
  "apa7": "Kum, J., Ko, Y., Chang, J. H., & Lee, C.-H. (2026). Dynamic modeling and techno-economic analysis of a heat-integrated NH3 cracking plant for cost-effective H2 production under uncertainty. Applied Energy, 406, 127210. https://doi.org/10.1016/j.apenergy.2025.127210",
  "doi": "10.1016/j.apenergy.2025.127210",
  "url": "https://doi.org/10.1016/j.apenergy.2025.127210",
  "doi_verified": true,
  "year": 2026,
  "type": "article",
  "equations": [
    {"id": "Eq2", "name": "Temkin-Pyzhev NH3 decomposition rate", "expression": "r = ko*exp(-Ea/(R*T)) * [ (P_NH3^2/P_H2^3)^beta - (P_N2/Keq^2)*(P_H2^3/P_NH3^2)^(1-beta) ]", "variables": {"r": "reaction rate, mol/(g-cat s)", "ko": "pre-exponential factor, mol/g-cat/s*(bar^0.27)", "Ea": "activation energy, J/mol", "R": "gas constant (nomenclature lists m3 bar/mol/K; J/mol/K needed in exponent)", "T": "temperature, K", "P_i": "partial pressure, bar", "beta": "Temkin exponent, -", "Keq": "equilibrium constant from Eq. 3, basis ambiguous"}, "page": 4, "applies_to": "Ru(8 wt%)/Al2O3 Hypermec 10010, 623.15-773.15 K"},
    {"id": "Eq3-4", "name": "Equilibrium constant", "expression": "Keq = exp(-dGr/(R*T)); dGr = 95117 - 193.67*T - 0.035293*T^2 + 9.22e-6*T^3", "variables": {"dGr": "standard Gibbs energy of reaction (unit not printed, J implied; magnitude matches 2NH3 -> N2 + 3H2 basis)", "T": "K"}, "page": 4, "applies_to": "NH3 decomposition equilibrium, taken from Realpe et al. 2024 [18]"},
    {"id": "T2-mass", "name": "2D tube mass balance", "expression": "eps_b dCi/dt + eps_b Vz dCi/dz = eps_b Deff,i [d2Ci/dz2 + d2Ci/dr2 + (1/r) dCi/dr] + nu_i (1-eps_b) rho_cat r", "variables": {"Ci": "concentration, kmol/m3", "Vz": "axial velocity, m/s", "Deff,i": "effective diffusivity, m2/s", "nu_i": "stoichiometric coefficient", "rho_cat": "catalyst density, kg/m3", "eps_b": "bed porosity"}, "page": 5, "applies_to": "Table 2 tube domain"},
    {"id": "T2-energy", "name": "2D tube energy balance", "expression": "[eps_b rho_g Cp_g + (1-eps_b) rho_cat Cp_cat] dT/dt + eps_b Vz rho_g Cp_g dT/dz = keff [d2T/dz2 + d2T/dr2 + (1/r) dT/dr] + nu_NH3 (1-eps_b) rho_cat dHr r", "variables": {"keff": "effective thermal conductivity, W/m/K", "dHr": "reaction enthalpy, J/mol", "Cp": "heat capacity"}, "page": 5, "applies_to": "Table 2 tube domain"},
    {"id": "T2-ergun", "name": "Ergun momentum balance", "expression": "-dP/dz = 150 mu Vz (1-eps_b)^2/(dp^2 eps_b^3) + 1.75 rho_g (1-eps_b)/eps_b * Vz^2/dp (as extracted; standard Ergun has eps_b^3 in the inertial term)", "variables": {"mu": "viscosity, kg/m/s", "dp": "particle diameter, m", "P": "pressure"}, "page": 5, "applies_to": "tube and TSA bed"},
    {"id": "T2-wall", "name": "Wall conduction", "expression": "rho_w Cp_w dTw/dt = k_w [d2Tw/dz2 + d2Tw/dr2 + (1/r) dTw/dr]", "variables": {"rho_w": "7720 kg/m3", "Cp_w": "502 J/kg/K", "k_w": "29.58 W/m/K"}, "page": 5, "applies_to": "tube wall Rin<r<Rout"},
    {"id": "T2-flue", "name": "1D flue gas energy balance", "expression": "rho_fg Cp_fg dTfg/dt + rho_fg Vz,fg Cp_fg dTfg/dz = (4 h_fg/Dout)(Tw(Rout)-Tfg) + (4 sigma_SB e/Dout)(Tw(Rout)^4 - Tfg^4)", "variables": {"h_fg": "flue-gas convective coefficient, W/m2/K (correlation in Suppl. A)", "sigma_SB": "Stefan-Boltzmann constant", "e": "emissivity", "Dout": "tube OD, m"}, "page": 5, "applies_to": "flue gas zone"},
    {"id": "T4-toth", "name": "Toth isotherm + LDF", "expression": "dqi/dt = omega_i (qeq,i - qi); qeq,i = qs,i bi P yi / [1 + (sum bi P yi)^ti]^(1/ti); bi = bo,i exp(Bi/T); ti = to,i + Ci/T", "variables": {"qs,i": "mol/kg", "bo,i": "Pa^-1", "Bi": "K", "Ci": "K", "omega_i": "s^-1"}, "page": 6, "applies_to": "zeolite 4A TSA"},
    {"id": "Eq10", "name": "NH3 conversion", "expression": "X = [Fin(0) yNH3(0) - Fout(L) yNH3(L)] / [Fin(0) yNH3(0)] * 100", "variables": {"F": "molar flow, mol/s", "y": "mole fraction"}, "page": 5, "applies_to": "cracker"},
    {"id": "Eq16", "name": "GHSV", "expression": "GHSV = V_STP / V_cat", "variables": {"V_STP": "m3/h at STP", "V_cat": "catalyst volume, m3"}, "page": 7, "applies_to": "cracker"},
    {"id": "Eq20", "name": "PEC correlation", "expression": "PEC = (a + b*S^n) * (CEPCI_2024/CEPCI_base) * Fm * FP", "variables": {"S": "size parameter (heat-exchange area for cracker; duty for furnace)", "Fm": "material factor 3", "FP": "pressure factor 1.5"}, "page": 7, "applies_to": "cracker and furnace (Towler & Sinnott)"},
    {"id": "Eq21", "name": "Capital recovery factor", "expression": "CRF = i(1+i)^n / ((1+i)^n - 1)", "variables": {"i": "discount rate", "n": "plant life, yr"}, "page": 7, "applies_to": "TEA"},
    {"id": "Eq22", "name": "H2 production cost", "expression": "LCOH = (CAPEX + OPEX)[USD/yr] / (H2 produced [kg/h] * operating hours [h/yr])", "variables": {"CAPEX": "TCI*CRF"}, "page": 8, "applies_to": "TEA"},
    {"id": "Eq27", "name": "NPV", "expression": "NPV = sum_{n=1..N} CashFlow_n/(1+i)^n - TCI; CashFlow_n = Revenue - OPEX - Depreciation_n; Depreciation_n = FCI (1-d)^(n-1) d", "variables": {"d": "depreciation rate 7 %"}, "page": 8, "applies_to": "TEA"}
  ],
