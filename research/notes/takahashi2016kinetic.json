{
  "citekey": "takahashi2016kinetic",
  "apa7": "Takahashi, A., & Fujitani, T. (2016). Kinetic analysis of decomposition of ammonia over nickel and ruthenium catalysts. Journal of Chemical Engineering of Japan, 49(1), 22–28. https://doi.org/10.1252/jcej.14we431",
  "doi": "10.1252/jcej.14we431",
  "url": "https://doi.org/10.1252/jcej.14we431",
  "doi_verified": true,
  "year": 2016,
  "type": "article",
  "catalysts": [
    {"id": "Ni/MgO", "metal_loading_wt_pct": 30, "preparation": "impregnation of MgO with Ni(NO3)2, dried 110 C, calcined 600 C, pretreated 20% H2 at 600 C", "particle_size": "22-42 mesh", "page": 2},
    {"id": "Ru/MgO", "metal_loading_wt_pct": 5, "preparation": "impregnation of MgO with RuCl3, dried 110 C, calcined 600 C, pretreated 20% H2 at 600 C", "particle_size": "22-42 mesh", "page": 2}
  ],
  "reactor": "continuous-flow fixed-bed quartz tubular reactor, atmospheric pressure, isothermal; catalyst mass, bed volume and SV basis NOT reported (p. 2)",
  "equations": [
    {"id": "eq1", "name": "NH3 adsorption/desorption", "expression": "NH3(g) + s <=> NH3(a)  (k1 forward, k_-1 reverse)", "variables": {"s": "vacant surface site"}, "page": 2, "applies_to": "Ni/MgO and Ru/MgO"},
    {"id": "eq2", "name": "NH3 dehydrogenation (lumped, irreversible)", "expression": "NH3(a) + 3s -> N(a) + 3H(a)  (k2)", "variables": {}, "page": 2, "applies_to": "Ni/MgO and Ru/MgO"},
    {"id": "eq3", "name": "recombinative N2 desorption (irreversible)", "expression": "2N(a) -> N2(g) + 2s  (k3)", "variables": {}, "page": 2, "applies_to": "Ni/MgO and Ru/MgO"},
    {"id": "eq4", "name": "recombinative H2 desorption / H2 adsorption", "expression": "2H(a) <=> H2(g) + 2s  (k4 forward, k_-4 reverse)", "variables": {}, "page": 2, "applies_to": "Ni/MgO and Ru/MgO"},
    {"id": "eq5", "name": "rate of step 1", "expression": "r1 = k1*(p_NH3/p_total)*theta_s - (k1/K1)*theta_NH3", "variables": {"r1": "net rate of NH3 adsorption [mol s^-1 g_cat^-1]", "k1": "adsorption rate constant [mol s^-1 g^-1]", "K1": "equilibrium constant of step 1 = k1/k_-1 [-]", "p_NH3": "NH3 partial pressure [atm]", "p_total": "total pressure [atm]", "theta_s": "fraction of vacant sites [-]", "theta_NH3": "NH3(a) coverage [-]"}, "page": 2, "applies_to": "Ni/MgO and Ru/MgO"},
    {"id": "eq6", "name": "rate of step 2", "expression": "r2 = k2*theta_NH3*theta_s^3", "variables": {"r2": "dehydrogenation rate [mol s^-1 g^-1]", "k2": "rate constant [mol s^-1 g^-1]"}, "page": 2, "applies_to": "Ni/MgO and Ru/MgO"},
    {"id": "eq7", "name": "rate of step 3", "expression": "r3 = k3*theta_N^2", "variables": {"r3": "N2 desorption rate [mol N2 s^-1 g^-1]", "k3": "rate constant [mol s^-1 g^-1]", "theta_N": "N(a) coverage [-]"}, "page": 2, "applies_to": "Ni/MgO and Ru/MgO"},
    {"id": "eq8", "name": "rate of step 4", "expression": "r4 = k4*theta_H^2 - (k4/K4)*(p_H2/p_total)*theta_s^2", "variables": {"r4": "net H2 desorption rate [mol H2 s^-1 g^-1]", "k4": "rate constant [mol s^-1 g^-1]", "K4": "equilibrium constant of step 4 = k4/k_-4 [-]", "p_H2": "H2 partial pressure [atm]", "theta_H": "H(a) coverage [-]"}, "page": 2, "applies_to": "Ni/MgO and Ru/MgO"},
    {"id": "eq9", "name": "K1 definition", "expression": "K1 = k1/k_-1", "variables": {}, "page": 2, "applies_to": "both"},
    {"id": "eq10", "name": "K4 definition", "expression": "K4 = k4/k_-4", "variables": {}, "page": 2, "applies_to": "both"},
    {"id": "eq11", "name": "site balance", "expression": "theta_s = 1 - theta_NH3 - theta_N - theta_H", "variables": {}, "page": 2, "applies_to": "both"},
    {"id": "eq12", "name": "QSS NH3(a)", "expression": "d(theta_NH3)/dt = r1 - r2 = 0", "variables": {"t": "time [s]"}, "page": 2, "applies_to": "both"},
    {"id": "eq13", "name": "QSS N(a)", "expression": "d(theta_N)/dt = r2 - 2*r3 = 0", "variables": {}, "page": 2, "applies_to": "both"},
    {"id": "eq14", "name": "QSS H(a)", "expression": "d(theta_H)/dt = 3*r2 - 2*r4 = 0", "variables": {}, "page": 2, "applies_to": "both"},
    {"id": "eq15", "name": "PFR total molar flow", "expression": "dF/dm = -r1 + r3 + r4", "variables": {"F": "total molar flow [mol s^-1]", "m": "catalyst mass [g]"}, "page": 2, "applies_to": "isothermal PFR"},
    {"id": "eq16", "name": "PFR NH3 mole fraction", "expression": "dy_NH3/dm = (-r1 - y_NH3*(-r1 + r3 + r4))/F", "variables": {"y_NH3": "NH3 mole fraction [-]"}, "page": 3, "applies_to": "isothermal PFR"},
    {"id": "eq17", "name": "PFR N2 mole fraction", "expression": "dy_N2/dm = (r3 - y_N2*(-r1 + r3 + r4))/F", "variables": {"y_N2": "N2 mole fraction [-]"}, "page": 3, "applies_to": "isothermal PFR"},
    {"id": "eq18", "name": "PFR H2 mole fraction", "expression": "dy_H2/dm = (r4 - y_H2*(-r1 + r3 + r4))/F", "variables": {"y_H2": "H2 mole fraction [-]"}, "page": 3, "applies_to": "isothermal PFR"},
    {"id": "eq19", "name": "PFR Ar mole fraction", "expression": "dy_Ar/dm = (-y_Ar*(-r1 + r3 + r4))/F", "variables": {"y_Ar": "Ar mole fraction [-]"}, "page": 3, "applies_to": "isothermal PFR"},
    {"id": "eq20", "name": "k1 (non-activated)", "expression": "k1 = A1", "variables": {"A1": "pre-exponential factor [mol s^-1 g^-1]"}, "page": 3, "applies_to": "both"},
    {"id": "eq21", "name": "k2 Arrhenius", "expression": "k2 = A2*exp(-Ea2/(R*T))", "variables": {"A2": "[mol s^-1 g^-1]", "Ea2": "activation energy [J mol^-1]", "R": "gas constant [J K^-1 mol^-1]", "T": "temperature; nomenclature says degC but Arrhenius requires K (verified: K reproduces Table 2 within 2-7%)"}, "page": 3, "applies_to": "both"},
    {"id": "eq22", "name": "k3 Arrhenius", "expression": "k3 = A3*exp(-Ea3/(R*T))", "variables": {"A3": "[mol s^-1 g^-1]", "Ea3": "[J mol^-1]"}, "page": 3, "applies_to": "both"},
    {"id": "eq23", "name": "k4 Arrhenius", "expression": "k4 = A4*exp(-Ea4/(R*T))", "variables": {"A4": "[mol s^-1 g^-1]", "Ea4": "[J mol^-1]"}, "page": 3, "applies_to": "both"},
    {"id": "eq24", "name": "K1 van 't Hoff form", "expression": "K1 = A5*exp(-Ea5/(R*T))", "variables": {"A5": "[-]", "Ea5": "[J mol^-1]; negative value = exothermic adsorption"}, "page": 3, "applies_to": "both"},
    {"id": "eq25", "name": "K4 van 't Hoff form", "expression": "K4 = A6*exp(-Ea4/(R*T))", "variables": {"A6": "[-]", "Ea4": "same Ea as k4, hence k_-4 = A4/A6 independent of T"}, "page": 3, "applies_to": "both"},
    {"id": "eq26", "name": "Temkin-Pyzhev rate law (quoted, not fitted)", "expression": "r = k*(p_NH3^2/p_H2^3)^beta", "variables": {"k": "rate constant (no value given)", "beta": "Temkin exponent (no value given)", "p_NH3": "[atm]", "p_H2": "[atm]"}, "page": 6, "applies_to": "generic; cited from Egawa et al. 1984, Chellappa et al. 2002, Yin et al. 2004, Zhang et al. 2005b"}
  ],
