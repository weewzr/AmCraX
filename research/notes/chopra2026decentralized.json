  "equations": [
    {
      "id": "chopra2026decentralized_eq1",
      "name": "Ammonia decomposition reaction and enthalpy",
      "expression": "2 NH3 <=> N2 + 3 H2,  dH0_R = 46.22 kJ/mol (printed as 'kJ mol H2^-1')",
      "variables": {"dH0_R": "standard reaction enthalpy; printed unit kJ per mol H2 - ambiguous, numerically equal to the per-mol-NH3 value (~46 kJ/mol NH3)"},
      "page": 3,
      "applies_to": "reaction thermochemistry (quoted from Spatolisano et al. 2023 [27])"
    },
    {
      "id": "chopra2026decentralized_eq2",
      "name": "Temkin-Pyzhev type rate expression",
      "expression": "r = k0 * exp(-E0/(R*T)) * (P_NH3^2 / P_H2^3)^beta",
      "variables": {
        "r": "reaction rate (unit not stated)",
        "k0": "pre-exponential factor, 2.92e6 s^-1 (Table 1)",
        "E0": "activation energy, 141.5 kJ/mol (Table 1)",
        "R": "universal gas constant",
        "T": "reaction temperature, K",
        "P_NH3": "partial pressure of NH3 (unit not stated)",
        "P_H2": "partial pressure of H2 (unit not stated)",
        "beta": "kinetic order (value NOT reported in main text)"
      },
      "page": 4,
      "applies_to": "six-zone catalytic cracker R1-R6 in Aspen Plus; catalyst listed in Table 1 as lithium imide (Li2NH); parameters 'determined from the reported experimental data [28,29]' (Armenise et al. 2013; 2018)"
    },
    {
      "id": "chopra2026decentralized_eq4",
      "name": "Cost index escalation",
      "expression": "C2 = C1 * (I2 / I1)",
      "variables": {"C1": "reference equipment cost, USD", "C2": "escalated cost, USD (2025)", "I1": "CEPCI 2001 = 397", "I2": "CEPCI 2025 = 798.8"},
      "page": 4,
      "applies_to": "equipment cost escalation to 2025 (Turton et al. 2008 [37])"
    },
    {
      "id": "chopra2026decentralized_eq5",
      "name": "Capacity scaling (six-tenths type rule)",
      "expression": "C2 = C1 * (A2 / A1)^n",
      "variables": {"A1": "reference size", "A2": "new size", "n": "cost exponent = 0.8", "C1": "reference cost", "C2": "scaled cost"},
      "page": 4,
      "applies_to": "equipment cost scaling; location factor India = 0.65 applied"
    }
  ],
