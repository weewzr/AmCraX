;
; AmCraX ammonia cracking - ci_tni_T594_P20_W100_hi
; Generated by amcrax.aspen.inp_writer - do not edit by hand; regenerate from CaseInputs.
;
TITLE 'AmCraX ammonia cracking - ci_tni_T594_P20_W100_hi'

IN-UNITS MET PRESSURE=bar TEMPERATURE=C DELTA-T=C PDROP=bar  &
        ENTHALPY-FLO=kW POWER=kW

DEF-STREAMS CONVEN ALL

MODEL-OPTION

DESCRIPTION "
    AmCraX ammonia-cracking flowsheet: refrigerated liquid NH3 is pumped, vaporised, preheated against the reactor effluent, cracked in a catalyst-kinetic RPLUG, cooled and split in a reduced-order PSA block; the PSA tail gas is burned with air. Property method: PENG-ROB.
    "

DATABANKS 'APV150 PURE41' / 'APV150 AQUEOUS' /  &
        'APV150 INORGANIC' / NOASPENPCD

PROP-SOURCES 'APV150 PURE41' / 'APV150 AQUEOUS' /  &
        'APV150 INORGANIC'

COMPONENTS
    NH3 H3N /
    H2 H2 /
    N2 N2 /
    H2O H2O /
    O2 O2

SOLVE
    RUN-MODE MODE=SIM

FLOWSHEET
    BLOCK PUMP IN=FEED OUT=S1
    BLOCK VAPORIZR IN=S1 OUT=S2
    BLOCK FEHE IN=S5 S2 OUT=S6 S3
    BLOCK HEATER IN=S3 H2SEED OUT=S4
    BLOCK CRACKER IN=S4 OUT=S5
    BLOCK COOLER IN=S6 OUT=S7
    BLOCK PSA IN=S7 OUT=H2PROD TAILGAS
    BLOCK BURNER IN=TAILGAS AIR OUT=FLUE
    BLOCK FLUEHX IN=FLUE OUT=STACK

PROPERTIES PENG-ROB

STREAM FEED
    SUBSTREAM MIXED PRES=1.013 VFRAC=0. MOLE-FLOW=100.
    MOLE-FRAC NH3 0.998 / H2O 0.002

STREAM H2SEED
    SUBSTREAM MIXED TEMP=594. PRES=21.2
    MOLE-FLOW H2 0.01497 / N2 0.00499

STREAM AIR
    SUBSTREAM MIXED TEMP=25. PRES=1.3 MOLE-FLOW=100.
    MOLE-FRAC N2 0.79 / O2 0.21

BLOCK PUMP PUMP
    PARAM PRES=21. EFF=0.75

BLOCK VAPORIZR HEATER
    PARAM PRES=20.8 DEGSUP=10.

BLOCK FEHE HEATX
    PARAM T-COLD=544. CALC-TYPE=DESIGN  &
        PRES-HOT=-0.3 PRES-COLD=-0.3  &
        U-OPTION=PHASE F-OPTION=CONSTANT CALC-METHOD=SHORTCUT
    FEEDS HOT=S5 COLD=S2
    OUTLETS-HOT S6
    OUTLETS-COLD S3
    HOT-SIDE DP-OPTION=CONSTANT
    COLD-SIDE DP-OPTION=CONSTANT
    TQ-PARAM CURVE=YES

BLOCK HEATER HEATER
    PARAM TEMP=594. PRES=20.2

BLOCK CRACKER RPLUG
    PARAM TYPE=T-SPEC NTUBE=50 LENGTH=0.2557366515 <meter>  &
        DIAM=0.126 <meter> NPOINT=50 NPHASE=1 PHASE=V  &
        IGN-CAT-VOL=NO  &
        CAT-PRESENT=YES BED-VOIDAGE=0.36 CAT-RHO=980. <kg/cum>  &
        PRES=0.
    T-SPEC 0. 594.
    REACTIONS RXN-IDS=NH3KIN

BLOCK COOLER HEATER
    PARAM TEMP=40. PRES=19.5

BLOCK PSA SEP
    PARAM
    FRAC STREAM=H2PROD SUBSTREAM=MIXED COMPS=NH3 H2 N2 H2O O2 FRACS=  &
        0. 0.85 0.001 0. 0.
    FLASH-SPECS H2PROD PRES=19.
    FLASH-SPECS TAILGAS PRES=1.3

BLOCK BURNER RSTOIC
    PARAM PRES=1.2 DUTY=0.
    STOIC 1 MIXED H2 -1. / O2 -0.5 / H2O 1.
    STOIC 2 MIXED NH3 -1. / O2 -0.75 / N2 0.5 / H2O 1.5
    CONV 1 MIXED H2 1.
    CONV 2 MIXED NH3 1.

BLOCK FLUEHX HEATER
    PARAM TEMP=150. PRES=1.1

CALCULATOR AIRCALC
    DEFINE FH2 MOLE-FLOW STREAM=TAILGAS SUBSTREAM=MIXED  &
        COMPONENT=H2
    DEFINE FNH3 MOLE-FLOW STREAM=TAILGAS SUBSTREAM=MIXED  &
        COMPONENT=NH3
    DEFINE FAIR STREAM-VAR STREAM=AIR SUBSTREAM=MIXED  &
        VARIABLE=MOLE-FLOW
F     FAIR = (0.5*FH2 + 0.75*FNH3) * 1.15 / 0.21
    READ-VARS FH2 FNH3
    WRITE-VARS FAIR

REACTIONS NH3KIN GENERAL
    PARAM NTERM-ADS=3
    REAC-DATA 1 NAME=NH3DEC REAC-CLASS=LHHW PHASE=V  &
        CBASIS=MOLEFRAC RBASIS=CAT-WT REVERSIBLE=YES  &
        REV-METH=USER-SPEC
    RATE-CON 1 PRE-EXP=766.2220774 ACT-ENERGY=84.77542189 <kJ/mol>  &
        TEMP-EXPONEN=0.
    STOIC 1 MIXED NH3 -1. / N2 0.5 / H2 1.5
    DFORCE-EXP 1 MIXED NH3 0.9660883303
    DFORCE-EXP-2 1 MIXED NH3 -0.03391166971 / MIXED N2 0.5 / MIXED H2 1.5
    DFORCE-EQ-1 REACNO=1 A=0. B=0. C=0. D=0.
    DFORCE-EQ-2 REACNO=1 A=9.867552835 B=4838.814745 C=-2.941088978 D=0.001161171459
    ADSORP-EXP REACNO=1 CID=H2 SSID=MIXED EXPONENT=0. 0.9780783356 0. /  &
        REACNO=1 CID=NH3 SSID=MIXED EXPONENT=0. 0. 1.
    ADSORP-EQTER REACNO=1 TERM= 1 A=0. B=0. C=0. D=0. /  &
        REACNO=1 TERM= 2 A=-12.6000176 B=11105.12582 C=0. D=0. /  &
        REACNO=1 TERM= 3 A=-1.200532097 B=1516.96249 C=0. D=0.
    ADSORP-POW REACNO=1 EXPONENT=1.778052036
    REAC-ACT 1

STREAM-REPOR MOLEFLOW MASSFLOW MOLEFRAC MASSFRAC
