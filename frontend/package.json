{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare_site.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prebuild:pages": "node scripts/prepare_site.mjs",
    "build:pages": "tsc -b && vite build --mode pages",
