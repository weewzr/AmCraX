{
  // rust-analyzer must not compile or run code on development machines where freshly built
  // executables are blocked (build scripts and proc-macro servers are executables). Compilation
  // and tests run in GitHub Actions (.github/workflows/rust.yml); see rust/README.md.
  "rust-analyzer.linkedProjects": ["rust/Cargo.toml"],
  "rust-analyzer.cargo.buildScripts.enable": false,
  "rust-analyzer.procMacro.enable": false,
  "rust-analyzer.checkOnSave": false
}
